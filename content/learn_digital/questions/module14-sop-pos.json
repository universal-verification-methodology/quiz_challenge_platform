{
  "module": "module14-sop-pos",
  "title": "SOP / POS",
  "items": [
    {
      "id": "sop_easy_01",
      "type": "multiple_choice",
      "prompt": "Canonical SOP includes minterms where F equals…",
      "choices": [
        "0",
        "1",
        "X",
        "either"
      ],
      "answer": 1,
      "explain": "SOP ORs products for rows where F is 1.",
      "difficulty": "easy"
    },
    {
      "id": "sop_easy_02",
      "type": "multiple_choice",
      "prompt": "Product-of-sums uses rows where F is…",
      "choices": [
        "0",
        "1",
        "X",
        "either"
      ],
      "answer": 0,
      "explain": "POS ANDs sums for rows where F is 0.",
      "difficulty": "easy"
    },
    {
      "id": "sop_easy_03",
      "type": "multiple_choice",
      "prompt": "Which product is true only on AB=00?",
      "choices": [
        "AB",
        "A'B'",
        "(A+B)",
        "(A'+B')"
      ],
      "answer": 1,
      "explain": "m0 is the 00 row: A' AND B'.",
      "difficulty": "easy"
    },
    {
      "id": "sop_easy_04",
      "type": "true_false",
      "prompt": "Sigma notation always equals the smallest SOP cover.",
      "answer": false,
      "explain": "Canonical lists every term; minimization may shrink them.",
      "difficulty": "easy"
    },
    {
      "id": "sop_medium_01",
      "type": "multiple_choice",
      "prompt": "2-var maxterm M0 is the sum…",
      "choices": [
        "A'B'",
        "A+B",
        "AB",
        "A'+B'"
      ],
      "answer": 1,
      "explain": "M0 = A+B (false only when A=B=0).",
      "difficulty": "medium"
    },
    {
      "id": "sop_medium_02",
      "type": "multiple_choice",
      "prompt": "F=A⊕B is 1 on…",
      "choices": [
        "m0 and m3",
        "m1 and m2",
        "only m3",
        "m0 and m1"
      ],
      "answer": 1,
      "explain": "XOR is 1 on 01 and 10 → m1,m2.",
      "difficulty": "medium"
    },
    {
      "id": "sop_medium_03",
      "type": "multiple_choice",
      "prompt": "AND of A,B equals which Σm?",
      "choices": [
        "m0",
        "m1",
        "m2",
        "m3"
      ],
      "answer": 3,
      "explain": "Only m3 (AB) is 1.",
      "difficulty": "medium"
    },
    {
      "id": "sop_medium_04",
      "type": "true_false",
      "prompt": "Canonical POS ANDs a maxterm for each OFF row.",
      "answer": true,
      "explain": "m0 is a product; M0 is a sum — different shapes.",
      "difficulty": "medium"
    },
    {
      "id": "sop_hard_01",
      "type": "multiple_choice",
      "prompt": "If F is identically 0, canonical SOP is…",
      "choices": [
        "1",
        "0",
        "A",
        "A+A'"
      ],
      "answer": 1,
      "explain": "No ON minterms → SOP is 0.",
      "difficulty": "hard"
    },
    {
      "id": "sop_hard_02",
      "type": "multiple_choice",
      "prompt": "All-ones table: SOP and POS…",
      "choices": [
        "remain full of every term forever",
        "collapse to the constant 1",
        "become XOR only",
        "are undefined"
      ],
      "answer": 1,
      "explain": "All ones → both forms are tautology 1.",
      "difficulty": "hard"
    },
    {
      "id": "sop_hard_03",
      "type": "multiple_choice",
      "prompt": "Two-var XOR ΠM includes…",
      "choices": [
        "M1 and M2",
        "M0 and M3",
        "only M0",
        "M0–M3 all"
      ],
      "answer": 1,
      "explain": "XOR is 0 on 00 and 11 → M0 and M3.",
      "difficulty": "hard"
    },
    {
