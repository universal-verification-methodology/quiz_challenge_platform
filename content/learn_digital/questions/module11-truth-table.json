{
  "module": "module11-truth-table",
  "title": "Truth tables",
  "items": [
    {
      "id": "truth_easy_01",
      "type": "multiple_choice",
      "prompt": "How many rows does a truth table with 3 inputs have?",
      "choices": [
        "3",
        "6",
        "8",
        "16"
      ],
      "answer": 2,
      "explain": "2^n rows: 2^3 = 8.",
      "difficulty": "easy"
    },
    {
      "id": "truth_easy_02",
      "type": "multiple_choice",
      "prompt": "AND of A and B is high only if…",
      "choices": [
        "A or B is 1",
        "A and B are both 1",
        "A and B differ",
        "both are 0"
      ],
      "answer": 1,
      "explain": "AND is 1 only on the 11 row.",
      "difficulty": "easy"
    },
    {
      "id": "truth_easy_03",
      "type": "multiple_choice",
      "prompt": "A⊕B equals 1 for which relationship?",
      "choices": [
        "A and B are equal",
        "A and B differ",
        "both are 1",
        "both are 0"
      ],
      "answer": 1,
      "explain": "XOR is 1 on 01 and 10 rows.",
      "difficulty": "easy"
    },
    {
      "id": "truth_easy_04",
      "type": "true_false",
      "prompt": "Duplicate input rows are required for a valid truth table.",
      "answer": false,
      "explain": "Every combination once; duplicates hide bugs.",
      "difficulty": "easy"
    },
    {
      "id": "truth_medium_01",
