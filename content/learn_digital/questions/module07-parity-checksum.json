        "N/A"
      ],
      "answer": 0,
      "explain": "Odd parity is the complement of even parity for the same data.",
      "difficulty": "medium"
    },
    {
      "id": "parity_hard_01",
      "type": "multiple_choice",
      "prompt": "If even parity over data||P is checked, a correct frame has…",
      "choices": [
        "1",
        "0",
        "0xFF",
        "MSB only"
      ],
      "answer": 1,
      "explain": "Whole codeword has even ones → XOR is 0.",
      "difficulty": "hard"
    },
    {
      "id": "parity_hard_02",
      "type": "multiple_choice",
      "prompt": "XOR checksum for bytes 0x01, 0x02 should be…",
      "choices": [
        "0x00",
        "0x03",
        "0xFF",
        "0x12"
      ],
      "answer": 1,
      "explain": "0x01 ^ 0x02 = 0x03; that checksum folds to 0.",
      "difficulty": "hard"
    },
    {
      "id": "parity_hard_03",
      "type": "true_false",
      "prompt": "Memory DIMMs may use ECC beyond simple parity.",
      "answer": true,
      "explain": "Parity detects; ECC syndromes correct/locate; XOR may not pinpoint.",
      "difficulty": "hard"
    },
    {
      "id": "parity_hard_04",
      "type": "multiple_choice",
      "prompt": "2D parity schemes increase…",
      "choices": [
        "Clock frequency only",
        "Error detection coverage / occasional location",
        "ASCII glyph count",
        "Endian conversion"
      ],
      "answer": 1,
      "explain": "Extra parity dimensions catch more patterns and can hint at location.",
      "difficulty": "hard"
    },
