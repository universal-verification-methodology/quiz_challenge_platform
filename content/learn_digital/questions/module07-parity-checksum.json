        "2"
      ],
      "answer": 0,
      "explain": "XOR of bits = 0 for even parity.",
      "difficulty": "medium"
    },
    {
      "id": "parity_medium_06",
      "type": "multiple_choice",
      "prompt": "Odd parity bit for data 0b1000 is…",
