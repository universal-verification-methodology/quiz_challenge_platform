{
  "module": "module07-parity-checksum",
  "title": "Parity / checksum",
  "items": [
    {
      "id": "parity_easy_01",
      "type": "multiple_choice",
      "prompt": "Even parity bit is commonly equal to…",
      "choices": [
        "OR of all bits",
        "Reduction XOR of data bits",
        "AND of all bits",
        "Bit count divided by 8"
      ],
      "answer": 1,
      "explain": "Even parity bit is the XOR of the data bits.",
      "difficulty": "easy"
    },
    {
      "id": "parity_easy_02",
      "type": "multiple_choice",
      "prompt": "Parity’s job versus ECC correction…",
      "choices": [
        "Yes, always",
        "Yes, for two-bit errors",
        "No — it detects (many) flips",
        "Only in odd mode"
      ],
      "answer": 2,
      "explain": "Parity detects many single-bit errors; it does not correct them.",
      "difficulty": "easy"
    },
    {
      "id": "parity_easy_03",
      "type": "multiple_choice",
      "prompt": "Successful XOR checksum fold result is…",
      "choices": [
        "0xFF",
        "0",
        "Equal to the last byte",
        "Odd"
      ],
      "answer": 1,
      "explain": "XOR fold to zero means the check matched.",
      "difficulty": "easy"
    },
    {
      "id": "parity_easy_04",
      "type": "true_false",
      "prompt": "Odd parity forces an odd number of 1s including the parity bit.",
      "answer": true,
      "explain": "Single flips fail parity; some multi-bit errors can sneak through.",
      "difficulty": "easy"
    },
    {
      "id": "parity_medium_01",
      "type": "multiple_choice",
      "prompt": "Even parity bit for data 0b1010 is…",
      "choices": [
        "0",
        "1",
        "X",
        "2"
      ],
      "answer": 0,
      "explain": "XOR of bits = 0 for even parity.",
      "difficulty": "medium"
    },
    {
      "id": "parity_medium_02",
      "type": "multiple_choice",
      "prompt": "Odd parity bit for data 0b1110 is…",
      "choices": [
        "0",
        "1",
        "Same as even always",
        "N/A"
      ],
      "answer": 0,
      "explain": "Odd parity is the complement of even parity for the same data.",
      "difficulty": "medium"
    },
    {
      "id": "parity_medium_03",
      "type": "true_false",
      "prompt": "Checksums stronger than parity can still miss some corruptions.",
      "answer": true,
      "explain": "Even numbers of flips can cancel; simple checks are not crypto.",
      "difficulty": "medium"
    },
    {
      "id": "parity_medium_04",
      "type": "multiple_choice",
      "prompt": "Which extra bit helps detect line errors?",
      "choices": [
        "A parity bit option",
        "A K-map",
        "An FSM encoding",
        "Endian swap only"
      ],
      "answer": 0,
      "explain": "Many UARTs optionally append parity.",
      "difficulty": "medium"
    },
    {
      "id": "parity_medium_05",
      "type": "multiple_choice",
      "prompt": "Even parity bit for data 0b0101 is…",
      "choices": [
        "0",
        "1",
