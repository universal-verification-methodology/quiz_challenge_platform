        "Always safer than CE",
        "Only affects reset",
        "Impossible in simulation"
      ],
      "answer": 0,
      "explain": "Raw AND can pulse clk_g.",
      "difficulty": "easy"
    },
    {
      "id": "clken_easy_04",
      "type": "true_false",
      "prompt": "CE=1 loads D on each posedge for a free-running clk.",
