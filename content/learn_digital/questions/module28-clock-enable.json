{
  "module": "module28-clock-enable",
  "title": "Clock enable",
  "items": [
    {
      "id": "clken_easy_01",
      "type": "multiple_choice",
      "prompt": "Preferred RTL style for conditional updates?",
      "choices": [
        "Clock enable (if ce) on free-running clk",
        "Raw AND gate on clk always",
        "No clock at all",
        "Only async reset"
      ],
      "answer": 0,
      "explain": "Clean clk; if (ce) q <= d.",
      "difficulty": "easy"
    },
    {
      "id": "clken_easy_02",
      "type": "multiple_choice",
      "prompt": "With clock enable low at posedge…",
      "choices": [
        "q holds (no load)",
        "q must toggle",
        "clk stops globally",
        "d drives q immediately"
      ],
      "answer": 0,
      "explain": "Enable off → recycle/hold.",
      "difficulty": "easy"
    },
    {
      "id": "clken_easy_03",
      "type": "multiple_choice",
      "prompt": "Enable glitch during clk high on gated clocks…",
      "choices": [
