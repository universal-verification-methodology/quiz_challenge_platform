{
  "module": "module25-clock-stepper",
  "title": "Clock-edge stepper",
  "items": [
    {
      "id": "clock_easy_01",
      "type": "multiple_choice",
      "prompt": "D flip-flop: when does Q capture D?",
      "choices": [
        "Any time D changes",
        "On posedge clk",
        "On negedge clk only",
        "When reset is low"
      ],
      "answer": 1,
      "explain": "q <= d on posedge clk.",
      "difficulty": "easy"
    },
    {
      "id": "clock_easy_02",
      "type": "multiple_choice",
      "prompt": "Poke D high, then what advances the sequential state?",
      "choices": [
        "Wait for Q to update immediately",
        "Advance a posedge of clk",
        "Toggle reset only",
        "Change the clock period"
      ],
      "answer": 1,
      "explain": "Poke first, then clock edge.",
      "difficulty": "easy"
    },
    {
      "id": "clock_easy_03",
      "type": "multiple_choice",
      "prompt": "Clocked enable off: what happens to Q?",
      "choices": [
        "Forces Q to follow D",
        "Holds Q (no capture)",
        "Toggles Q",
        "Drives Q to X"
      ],
      "answer": 1,
      "explain": "if (en) q <= d — EN off holds.",
      "difficulty": "easy"
    },
    {
      "id": "clock_easy_04",
      "type": "true_false",
      "prompt": "Changing D updates both pipeline stages on the same edge.",
      "answer": false,
      "explain": "Each stage advances one edge; two stages need two edges.",
      "difficulty": "easy"
    },
    {
      "id": "clock_medium_01",
      "type": "multiple_choice",
      "prompt": "Sequential logic samples inputs…",
      "choices": [
        "On every input wiggle",
        "On a clock edge",
        "Only at power-up",
        "Whenever EN is low"
      ],
      "answer": 1,
      "explain": "Samples on clock edges, not continuous D motion.",
      "difficulty": "medium"
    },
    {
      "id": "clock_medium_02",
      "type": "multiple_choice",
      "prompt": "Counters advance their count primarily on…",
      "choices": [
        "An asynchronous D change alone",
        "A clock edge (with enable if used)",
        "Only a mid-cycle reset pulse",
        "Removing the clock tree"
      ],
      "answer": 1,
      "explain": "Counters are edge-triggered after reset clears.",
      "difficulty": "medium"
    },
    {
      "id": "clock_medium_03",
      "type": "multiple_choice",
      "prompt": "Each FF in a shift register captures on…",
      "choices": [
        "Combinationally without clocks",
        "One stage per clock edge",
        "Only when reset asserts",
        "Whenever D floats"
      ],
      "answer": 1,
      "explain": "Each edge advances one stage.",
      "difficulty": "medium"
    },
    {
      "id": "clock_medium_04",
      "type": "true_false",
      "prompt": "Reset and enable are evaluated with data on the capturing edge.",
      "answer": true,
      "explain": "Edge FFs hold until the edge; latches differ; enable/reset matter on that edge.",
      "difficulty": "medium"
    },
    {
      "id": "clock_hard_01",
      "type": "multiple_choice",
      "prompt": "Browser clock-step labs teach literacy; real silicon still needs…",
      "choices": [
        "Setup/hold and CDC rules",
        "Only ASCII tables",
        "Removing all clocks",
        "Never using enable"
      ],
      "answer": 0,
      "explain": "Setup, hold, and CDC still apply in real designs.",
      "difficulty": "hard"
    },
    {
      "id": "clock_hard_02",
      "type": "multiple_choice",
      "prompt": "Besides D, edge sampling often considers…",
