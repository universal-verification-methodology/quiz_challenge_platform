{
  "module": "module45-dual-port-ram",
  "title": "Dual-port RAM",
  "items": [
    {
      "id": "dpram_easy_01",
      "type": "multiple_choice",
      "prompt": "Dual-port RAM provides…",
      "choices": [
        "Two independent addr/we/din ports on one array",
        "Two separate clock domains always",
        "Read-only access on both ports",
        "No address lines"
      ],
      "answer": 0,
      "explain": "Shared memory, two ports.",
      "difficulty": "easy"
    },
    {
      "id": "dpram_easy_02",
      "type": "multiple_choice",
      "prompt": "A=0, B=1 with no same-addr clash is…",
      "choices": [
        "Independent access (no collision)",
        "Automatic X on both dout",
        "Both ports must write",
        "Memory clears to zero"
      ],
      "answer": 0,
      "explain": "A=0, B=1 in starter.",
      "difficulty": "easy"
    },
    {
      "id": "dpram_easy_03",
      "type": "multiple_choice",
      "prompt": "Write-first collision read yields…",
      "choices": [
        "New (written) data",
        "Always old data only",
        "Always X",
        "The write pointer"
      ],
      "answer": 0,
      "explain": "Read-new after write.",
      "difficulty": "easy"
    },
    {
      "id": "dpram_easy_04",
      "type": "true_false",
      "prompt": "Independent ports can read and write different addresses concurrently.",
      "answer": true,
      "explain": "Simple dual/true dual may share a clock; async is separate.",
      "difficulty": "easy"
    },
    {
      "id": "dpram_medium_01",
      "type": "multiple_choice",
      "prompt": "read_first (write-after-read) collision returns…",
      "choices": [
        "Previous stored data",
        "Always the new din",
        "Always 0",
        "The address"
      ],
      "answer": 0,
      "explain": "Read-old behavior.",
      "difficulty": "medium"
    },
    {
      "id": "dpram_medium_02",
      "type": "multiple_choice",
      "prompt": "Two writes to one location in one cycle…",
      "choices": [
        "Hazard — need priority or avoid",
        "Always safe like R/R",
        "Forced empty FIFO",
        "A cache miss only"
      ],
      "answer": 0,
      "explain": "Two writers conflict.",
      "difficulty": "medium"
    },
    {
      "id": "dpram_medium_03",
      "type": "multiple_choice",
      "prompt": "SDP vs TDP: SDP typically…",
      "choices": [
        "1W1R rather than two fully symmetric R/W ports",
        "No addresses",
        "Only ROM",
        "Four write ports minimum"
      ],
      "answer": 0,
      "explain": "SDP ≠ true dual R/W+R/W.",
      "difficulty": "medium"
    },
    {
      "id": "dpram_medium_04",
      "type": "true_false",
      "prompt": "Collision never occurs if addresses are equal.",
      "answer": false,
      "explain": "Equal addresses are when collisions happen.",
      "difficulty": "medium"
    },
    {
      "id": "dpram_hard_01",
      "type": "multiple_choice",
      "prompt": "no_change collision policy means…",
      "choices": [
