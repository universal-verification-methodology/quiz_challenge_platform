      "id": "radix_easy_01",
      "type": "multiple_choice",
      "prompt": "Hex digit A equals which decimal value?",
      "choices": [
        "9",
        "10",
        "11",
        "16"
      ],
      "answer": 1,
      "explain": "Hex digits after 9 are A=10, B=11, …, F=15. So A₁₆ = 10₁₀. Option 16 is the base (radix), not the digit value.",
      "difficulty": "easy",
      "media": {
        "type": "video",
        "src": "media/videos/radix_easy_01.mp4",
        "poster": "media/images/radix_easy_01-frame.png",
        "figure": "media/images/radix_easy_01.png"
      },
      "tool_capture": {
        "tool": "radix-converter",
        "key": "hex-digit-A",
        "label": "Width 4 · hex A",
        "steps": [
          {
            "select": "#rc-width",
            "value": "4"
          },
          {
            "fill": "#rc-hex",
            "value": "A"
          }
        ]
      }
    },
