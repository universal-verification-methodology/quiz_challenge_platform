{
  "module": "module27-reset-timelines",
  "title": "Reset timelines",
  "items": [
    {
      "id": "reset_easy_01",
      "type": "multiple_choice",
      "prompt": "Synchronous reset is typically…",
      "choices": [
        "Only on the clock edge",
        "With no clock in the sensitivity list",
        "The same as $finish",
        "In analog continuous time only"
      ],
      "answer": 0,
      "explain": "if (!rst_n) inside @(posedge clk).",
      "difficulty": "easy"
    },
    {
      "id": "reset_easy_02",
      "type": "multiple_choice",
      "prompt": "Mid-cycle active-low reset: async vs sync?",
      "choices": [
        "Async can clear immediately; sync waits for posedge",
        "Both always ignore reset",
        "Sync always clears first",
        "The clock stops forever"
      ],
      "answer": 0,
      "explain": "Async clears now; sync waits for the edge.",
      "difficulty": "easy"
    },
    {
      "id": "reset_easy_03",
      "type": "multiple_choice",
      "prompt": "Active-low reset asserts when…",
      "choices": [
        "Active-low reset — clear when rst_n is 0",
        "Reset never asserts",
        "Reset is LVDS only",
        "The net must stay undriven Z"
      ],
      "answer": 0,
      "explain": "n = negative / active-low.",
      "difficulty": "easy"
    },
    {
      "id": "reset_easy_04",
      "type": "true_false",
      "prompt": "Both styles clear when rst_n is low at a posedge.",
