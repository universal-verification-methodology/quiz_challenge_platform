    {
      "id": "fifo_easy_01",
      "type": "multiple_choice",
      "prompt": "FIFO means…",
      "choices": [
        "First-In First-Out — oldest entry read next",
        "First-In Last-Out (stack)",
        "Random access like RAM",
        "Only a clock generator"
      ],
      "answer": 0,
      "explain": "Order-preserving queue.",
      "difficulty": "easy"
    },
    {
      "id": "fifo_easy_02",
      "type": "multiple_choice",
      "prompt": "One push into empty FIFO yields count…",
      "choices": [
        "1 (wr=1, rd=0)",
        "4 (full)",
        "0 (empty)",
        "2 always"
      ],
      "answer": 0,
      "explain": "One entry stored at slot 0.",
      "difficulty": "easy"
    },
    {
      "id": "fifo_easy_03",
      "type": "multiple_choice",
      "prompt": "When are all slots occupied?",
      "choices": [
        "count == DEPTH",
        "count == 0",
        "wr == 0 only",
        "rd == wr always"
      ],
      "answer": 0,
      "explain": "All slots occupied.",
      "difficulty": "easy"
    },
    {
      "id": "fifo_easy_04",
      "type": "true_false",
