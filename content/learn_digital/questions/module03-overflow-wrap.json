{
  "module": "module03-overflow-wrap",
  "title": "Overflow / wrap",
  "items": [
    {
      "id": "overflow_easy_01",
      "type": "multiple_choice",
      "prompt": "At width 4, unsigned 14+3 stores which wrapped result?",
      "choices": [
        "17",
        "1",
        "15",
        "0"
      ],
      "answer": 1,
      "explain": "17 mod 16 = 1.",
      "difficulty": "easy"
    },
    {
      "id": "overflow_easy_02",
      "type": "true_false",
      "prompt": "Unsigned carry and signed overflow are identical flags.",
      "answer": false,
      "explain": "Carry tracks unsigned out-of-range; overflow tracks signed.",
      "difficulty": "easy"
    },
    {
      "id": "overflow_easy_03",
      "type": "multiple_choice",
      "prompt": "Clamping to min/max instead of modulo is…",
      "choices": [
        "They are identical behaviors",
        "Saturation clamps to min/max; wrap uses modular bits",
        "Wrap only happens in floating point",
        "Saturation ignores width"
      ],
      "answer": 1,
      "explain": "Sat clamps; ordinary fixed-width add usually wraps.",
      "difficulty": "easy"
    },
    {
      "id": "overflow_easy_04",
      "type": "multiple_choice",
      "prompt": "Intentional wrap at full scale is common for…",
      "choices": [
        "Never wrapping",
        "Intentional wrap at the width",
        "Floating-point add",
        "Removing the MSB"
      ],
      "answer": 1,
      "explain": "Counters commonly count modulo 2^w.",
      "difficulty": "easy"
    },
    {
      "id": "overflow_medium_01",
      "type": "multiple_choice",
      "prompt": "At width 4, unsigned 14+3 wraps to…",
      "choices": [
        "17",
        "1",
        "15",
        "0"
      ],
      "answer": 1,
      "explain": "14+3=17; mod 16 → 1.",
      "difficulty": "medium"
    },
    {
      "id": "overflow_medium_02",
      "type": "multiple_choice",
      "prompt": "Four-bit signed 0111 + 0001 yields…",
      "choices": [
        "+8",
        "−8",
        "0",
        "+7"
      ],
      "answer": 1,
      "explain": "8 is out of range; pattern 1000 means −8.",
      "difficulty": "medium"
    },
    {
      "id": "overflow_medium_03",
      "type": "true_false",
      "prompt": "Checking only the carry flag proves there was no signed overflow.",
      "answer": false,
      "explain": "Signed overflow ≠ carry; width bounds the stored result.",
      "difficulty": "medium"
    },
    {
      "id": "overflow_medium_04",
      "type": "multiple_choice",
      "prompt": "If you do not build clamp logic, overflow tends to…",
      "choices": [
        "Saturate to max",
        "Wrap modulo 2^w",
        "Grow unlimited bits",
        "Trap to software always"
      ],
      "answer": 1,
      "explain": "Default is modular wrap unless you build saturation.",
      "difficulty": "medium"
    },
    {
      "id": "overflow_medium_05",
      "type": "multiple_choice",
      "prompt": "At width 8, unsigned 250+10 wraps to…",
      "choices": [
        "260",
        "4",
        "255",
        "0"
      ],
      "answer": 1,
      "explain": "250+10=260; mod 256 → 4.",
      "difficulty": "medium"
    },
    {
      "id": "overflow_medium_06",
      "type": "multiple_choice",
      "prompt": "At width 4, unsigned 12+5 wraps to…",
      "choices": [
        "17",
        "1",
        "15",
        "0"
      ],
      "answer": 1,
      "explain": "12+5=17; mod 16 → 1.",
      "difficulty": "medium"
    },
    {
      "id": "overflow_hard_01",
      "type": "multiple_choice",
      "prompt": "Signed overflow for add is often detected when…",
      "choices": [
        "Carry into MSB equals carry out of MSB (no overflow)",
        "Carry into MSB differs from carry out of MSB",
        "Any carry out of LSB",
        "Result equals zero"
      ],
      "answer": 1,
      "explain": "XOR of carry-in and carry-out of the MSB flags signed overflow.",
      "difficulty": "hard"
    },
    {
      "id": "overflow_hard_02",
      "type": "multiple_choice",
      "prompt": "Eight-bit unsigned decrement past zero yields…",
      "choices": [
        "−1",
        "0xFF (255)",
        "0x80",
        "0x01"
      ],
      "answer": 1,
      "explain": "Modular: −1 ≡ 255 mod 256.",
      "difficulty": "hard"
    },
    {
      "id": "overflow_hard_03",
      "type": "true_false",
      "prompt": "You must know width when verifying an adder result.",
      "answer": true,
      "explain": "Sat ≠ wrap; stored bits are modulo the width.",
      "difficulty": "hard"
    },
