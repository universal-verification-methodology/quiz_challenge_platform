{
  "module": "module17-gate-composer",
  "title": "Gate composer",
  "items": [
    {
      "id": "gates_easy_01",
      "type": "multiple_choice",
      "prompt": "The starter example implements F as…",
      "choices": [
        "A OR B",
        "A AND B",
        "A XOR B",
        "NOT A"
      ],
      "answer": 1,
      "explain": "Starter is one AND gate: F = A & B.",
      "difficulty": "easy"
    },
    {
      "id": "gates_easy_02",
      "type": "multiple_choice",
      "prompt": "XOR asserts when inputs…",
      "choices": [
        "A and B are equal",
        "A and B differ",
        "both are 1",
        "both are 0"
      ],
      "answer": 1,
      "explain": "XOR is 1 on rows 01 and 10.",
      "difficulty": "easy"
    },
    {
      "id": "gates_easy_03",
      "type": "multiple_choice",
      "prompt": "At least how many ones for 3-input majority?",
      "choices": [
        "exactly one input is 1",
        "at least two inputs are 1",
        "all inputs are 0",
        "parity is even"
      ],
      "answer": 1,
      "explain": "Majority is 1 when two or three inputs are 1.",
      "difficulty": "easy"
    },
    {
      "id": "gates_easy_04",
      "type": "true_false",
      "prompt": "Matching half the rows proves the net for all inputs.",
      "answer": false,
      "explain": "Exhaustive row match is the judge.",
      "difficulty": "easy"
    },
    {
      "id": "gates_medium_01",
      "type": "multiple_choice",
      "prompt": "Half-adder sum is which gate of A,B?",
      "choices": [
        "AND",
        "XOR",
        "OR",
        "NAND only"
      ],
      "answer": 1,
      "explain": "Sum is XOR; carry is AND.",
      "difficulty": "medium"
    },
    {
      "id": "gates_medium_02",
      "type": "multiple_choice",
      "prompt": "HA carry C equals…",
      "choices": [
        "XOR",
        "AND",
        "NOR",
        "XNOR"
      ],
      "answer": 1,
      "explain": "Carry is A AND B.",
      "difficulty": "medium"
    },
    {
      "id": "gates_medium_03",
      "type": "multiple_choice",
      "prompt": "Mux under A between B and C is…",
      "choices": [
        "Y follows B when A=0 and C when A=1 (typical)",
        "Y is always A⊕B",
        "Y ignores select",
        "Y is majority of A,B,C only"
      ],
      "answer": 0,
      "explain": "Select steers one data input to Y.",
      "difficulty": "medium"
    },
    {
      "id": "gates_medium_04",
      "type": "true_false",
      "prompt": "Leaving an input floating is fine if most rows still pass.",
      "answer": false,
      "explain": "Tie every input; FA sum/carry as stated.",
      "difficulty": "medium"
    },
    {
      "id": "gates_hard_01",
      "type": "multiple_choice",
      "prompt": "Full-adder Cout is which function of A,B,Cin?",
      "choices": [
        "A⊕B⊕Cin",
        "majority(A,B,Cin)",
        "A·B·Cin only",
        "A+B+Cin without AND terms"
      ],
      "answer": 1,
      "explain": "Cout is majority of A, B, Cin.",
      "difficulty": "hard"
    },
    {
      "id": "gates_hard_02",
      "type": "multiple_choice",
      "prompt": "A⊕B in SOP is…",
