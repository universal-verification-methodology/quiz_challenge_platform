{
  "module": "module10-endian-lab",
  "title": "Endian packing",
  "items": [
    {
      "id": "endian_easy_01",
      "type": "multiple_choice",
      "prompt": "Little-endian stores at the lowest address the…",
      "choices": [
        "MSB",
        "LSB",
        "sign bit only",
        "middle byte"
      ],
      "answer": 1,
      "explain": "LE stores LSB at +0.",
      "difficulty": "easy"
    },
    {
      "id": "endian_easy_02",
      "type": "multiple_choice",
      "prompt": "LE unpack of 0x12345678: first byte is…",
      "choices": [
        "0x12",
        "0x34",
        "0x56",
        "0x78"
      ],
      "answer": 3,
      "explain": "LE: 78 56 34 12.",
      "difficulty": "easy"
    },
    {
      "id": "endian_easy_03",
      "type": "multiple_choice",
      "prompt": "Big-endian on the network means…",
      "choices": [
        "little-endian",
        "big-endian",
        "host-dependent only",
        "random"
      ],
      "answer": 1,
      "explain": "Network order is big-endian by convention.",
      "difficulty": "easy"
    },
    {
      "id": "endian_easy_04",
      "type": "true_false",
      "prompt": "Host endian always matches network order.",
      "answer": false,
      "explain": "Value unchanged; only byte placement differs. Host ≠ wire often.",
      "difficulty": "easy"
    },
    {
      "id": "endian_medium_01",
      "type": "multiple_choice",
      "prompt": "For 0x12345678 little-endian, byte at +0 is…",
      "choices": [
        "0x12",
        "0x78",
        "0x00",
        "0xFF"
      ],
      "answer": 1,
      "explain": "LE LSB = 0x78.",
      "difficulty": "medium"
    },
    {
