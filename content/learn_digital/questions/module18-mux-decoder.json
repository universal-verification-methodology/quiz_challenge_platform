      ],
      "answer": 2,
      "explain": "2^2 = 4.",
      "difficulty": "medium"
    },
    {
      "id": "mux_medium_03",
      "type": "multiple_choice",
      "prompt": "One-hot input to binary index is an…",
      "choices": [
