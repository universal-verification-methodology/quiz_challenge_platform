{
  "module": "module18-mux-decoder",
  "title": "Mux / decoder / encoder",
  "items": [
    {
      "id": "mux_easy_01",
      "type": "multiple_choice",
      "prompt": "A 4:1 mux needs how many select bits?",
      "choices": [
        "1",
        "2",
        "4",
        "8"
      ],
      "answer": 1,
      "explain": "2^S = 4 inputs → S = 2 select bits.",
      "difficulty": "easy"
    },
    {
      "id": "mux_easy_02",
      "type": "multiple_choice",
      "prompt": "Decoder Y lines are usually…",
      "choices": [
        "all high at once",
        "one-hot",
        "always zero",
        "Gray coded only"
      ],
      "answer": 1,
      "explain": "Exactly one output active per address.",
      "difficulty": "easy"
    },
    {
      "id": "mux_easy_03",
      "type": "multiple_choice",
      "prompt": "How many Y lines on a 3-to-8?",
      "choices": [
        "3",
        "6",
        "8",
        "16"
      ],
      "answer": 2,
      "explain": "2^3 = 8 one-hot outputs.",
      "difficulty": "easy"
    },
    {
      "id": "mux_easy_04",
      "type": "true_false",
      "prompt": "Select S=0 always forces Y=0 regardless of D0.",
      "answer": false,
      "explain": "S chooses which data input reaches Y.",
      "difficulty": "easy"
    },
    {
      "id": "mux_medium_01",
