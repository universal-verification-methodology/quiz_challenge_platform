{
  "module": "module19-priority-compare",
  "title": "Priority & compare",
  "items": [
    {
      "id": "priority_easy_01",
      "type": "multiple_choice",
      "prompt": "4-input, high-index-first: I1=I3=1. Winner index?",
      "choices": [
        "1",
        "3",
        "0",
        "2"
      ],
      "answer": 1,
      "explain": "Higher index wins → I3.",
      "difficulty": "easy"
    },
    {
      "id": "priority_easy_02",
      "type": "multiple_choice",
      "prompt": "EO cascades when…",
      "choices": [
        "EI is high and no local request is active",
        "any input is high",
        "Y equals zero always",
        "priority is low-index-first"
      ],
      "answer": 0,
      "explain": "EO cascades when V=0 but EI=1.",
      "difficulty": "easy"
    },
    {
      "id": "priority_easy_03",
      "type": "multiple_choice",
      "prompt": "Unsigned 15 vs 1 and signed −1 vs 1…",
      "choices": [
        "Both say A<B",
        "Unsigned A>B, signed A<B",
        "Both say A>B",
        "Unsigned A<B, signed A>B"
      ],
      "answer": 1,
      "explain": "15u > 1u, but −1s < 1s.",
      "difficulty": "easy"
    },
    {
      "id": "priority_easy_04",
      "type": "true_false",
      "prompt": "High- and low-index-first always name the same winner.",
      "answer": false,
      "explain": "Priority direction changes the answer.",
      "difficulty": "easy"
    },
    {
      "id": "priority_medium_01",
      "type": "multiple_choice",
      "prompt": "Low-index-first: I1=I3=1. Winner?",
      "choices": [
        "3",
        "1",
        "0",
        "2"
      ],
      "answer": 1,
      "explain": "Lowest active index wins → I1.",
      "difficulty": "medium"
    },
    {
      "id": "priority_medium_02",
      "type": "multiple_choice",
      "prompt": "Idle local encoder with EI high reports…",
      "choices": [
        "V=1, EO=0",
        "V=0, EO=1",
        "V=1, EO=1",
        "V=0, EO=0"
      ],
      "answer": 1,
      "explain": "No local winner → V=0, EO=1.",
      "difficulty": "medium"
    },
    {
      "id": "priority_medium_03",
      "type": "multiple_choice",
      "prompt": "Magnitude-only view is…",
      "choices": [
        "pure magnitude / sign bit respectively",
        "always identical flags",
        "only Gray codes",
        "parity trees only"
      ],
      "answer": 0,
      "explain": "Unsigned = magnitude; signed = MSB is sign.",
      "difficulty": "medium"
    },
    {
      "id": "priority_medium_04",
      "type": "true_false",
      "prompt": "Comparator EQ/GT/LT flags ignore the signed-mode setting.",
      "answer": false,
      "explain": "Check signed mode; EO is cascade idle.",
      "difficulty": "medium"
    },
    {
      "id": "priority_hard_01",
      "type": "multiple_choice",
      "prompt": "4-bit A=1000, B=0001 unsigned vs signed?",
      "choices": [
        "Unsigned A>B, signed A<B",
        "Both A<B",
        "Both A>B",
        "Unsigned A<B, signed A>B"
      ],
      "answer": 0,
      "explain": "8u>1u but −8s<1s.",
      "difficulty": "hard"
    },
    {
      "id": "priority_hard_02",
      "type": "multiple_choice",
      "prompt": "Chaining encoders uses which pair?",
      "choices": [
        "EI/EO",
        "only Cin/Cout of adders",
        "SRA/SRL",
        "only OE of tri-states"
      ],
      "answer": 0,
      "explain": "Enable-in / enable-out cascade the search.",
      "difficulty": "hard"
    },
    {
      "id": "priority_hard_03",
      "type": "multiple_choice",
      "prompt": "With enable-in low…",
      "choices": [
        "still asserts local winners normally",
        "is masked — no local grant / EO path off as designed",
