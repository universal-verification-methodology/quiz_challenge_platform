{
  "module": "module06-bcd-lab",
  "title": "BCD",
  "items": [
    {
      "id": "bcd_easy_01",
      "type": "multiple_choice",
      "prompt": "How many bits does one BCD digit use?",
      "choices": [
        "2",
        "4",
        "8",
        "10"
      ],
      "answer": 1,
      "explain": "Each digit is a 4-bit nibble.",
      "difficulty": "easy"
    },
    {
      "id": "bcd_easy_02",
      "type": "multiple_choice",
      "prompt": "Valid BCD digits run through…",
      "choices": [
        "7",
        "9",
        "15",
        "F"
      ],
      "answer": 1,
      "explain": "Digits are 0–9; A–F are invalid.",
      "difficulty": "easy"
    },
    {
      "id": "bcd_easy_03",
      "type": "multiple_choice",
      "prompt": "Which hex is packed BCD 42 (not binary 42)?",
      "choices": [
        "0x2A",
        "0x42",
        "0x24",
        "42 binary bits"
      ],
      "answer": 1,
      "explain": "0x42 is BCD; binary 42 is 0x2A.",
      "difficulty": "easy"
    },
    {
      "id": "bcd_easy_04",
      "type": "true_false",
      "prompt": "0xF is acceptable in packed BCD as digit fifteen.",
      "answer": false,
      "explain": "0xA–0xF are not decimal digits in BCD.",
      "difficulty": "easy"
    },
    {
      "id": "bcd_medium_01",
      "type": "multiple_choice",
      "prompt": "Decimal 25 as packed BCD is…",
      "choices": [
        "0x19",
        "0x25",
        "0x34",
        "0xFF"
      ],
      "answer": 1,
      "explain": "Tens=2, ones=5 → 0x25.",
      "difficulty": "medium"
    },
    {
      "id": "bcd_medium_02",
      "type": "multiple_choice",
      "prompt": "Why isn’t binary 42 the same hex as BCD 42?",
      "choices": [
        "They are always identical",
        "Different encodings of the same decimal quantity",
        "BCD uses 10 bits per digit",
        "Binary forbids digit 2"
      ],
      "answer": 1,
      "explain": "Same decimal, different bit spellings.",
      "difficulty": "medium"
    },
    {
      "id": "bcd_medium_03",
      "type": "multiple_choice",
      "prompt": "If a BCD nibble sum is 0xA–0xF, a common fix is…",
      "choices": [
        "Ignoring it",
        "Adding 6 (DAA-style) to restore a decimal digit",
        "Shifting left 4",
        "Clearing the carry always"
      ],
      "answer": 1,
      "explain": "Add 6 when the nibble is not a valid digit (or carry).",
      "difficulty": "medium"
    },
    {
      "id": "bcd_medium_04",
      "type": "true_false",
      "prompt": "Displays and RTC chips commonly speak BCD.",
      "answer": true,
      "explain": "BCD is convenient for digits; denser binary usually wins for math.",
      "difficulty": "medium"
    },
