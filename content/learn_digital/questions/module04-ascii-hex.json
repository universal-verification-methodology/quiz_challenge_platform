    {
      "id": "ascii_easy_01",
      "type": "multiple_choice",
      "prompt": "Printable ASCII typically starts at which hex value (space)?",
      "choices": [
        "0x00",
        "0x0A",
        "0x20",
        "0x7F"
      ],
      "answer": 2,
      "explain": "Space is 0x20.",
      "difficulty": "easy"
    },
    {
      "id": "ascii_easy_02",
      "type": "multiple_choice",
      "prompt": "ASCII line feed (LF) equals…",
      "choices": [
        "0x0D only",
        "0x0A",
        "0x20",
        "0xFF"
      ],
      "answer": 1,
      "explain": "LF is 0x0A (CR is 0x0D).",
      "difficulty": "easy"
    },
    {
      "id": "ascii_easy_03",
      "type": "multiple_choice",
      "prompt": "Which byte terminates a classic C string?",
      "choices": [
