        "0x0A",
        "0x00",
        "0xFF"
      ],
      "answer": 2,
      "explain": "NUL (0x00) terminates a C string.",
      "difficulty": "easy"
    },
    {
      "id": "ascii_easy_04",
      "type": "true_false",
      "prompt": "Every byte 0x00–0xFF has a unique printable ASCII glyph.",
