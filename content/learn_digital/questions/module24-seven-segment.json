    {
      "id": "sevenseg_easy_01",
      "type": "multiple_choice",
      "prompt": "A classic seven-segment digit has how many segments?",
      "choices": [
        "6",
        "7",
        "8",
        "4"
      ],
      "answer": 1,
      "explain": "Segments a through g.",
      "difficulty": "easy"
    },
    {
      "id": "sevenseg_easy_02",
      "type": "multiple_choice",
      "prompt": "Pattern 1110111 has which bit 0 (abcdefg)?",
      "choices": [
        "a",
        "d",
        "g",
        "b"
      ],
      "answer": 1,
      "explain": "1110111 — d is 0.",
      "difficulty": "easy"
    },
    {
      "id": "sevenseg_easy_03",
      "type": "multiple_choice",
      "prompt": "On CC displays, drive 1 means…",
      "choices": [
        "0",
        "1",
        "Z",
        "X"
      ],
      "answer": 1,
      "explain": "1 = ON for CC.",
      "difficulty": "easy"
    },
    {
