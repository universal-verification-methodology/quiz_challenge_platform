{
  "module": "module09-bit-fields",
  "title": "Bit-fields",
  "items": [
    {
      "id": "bitfields_easy_01",
      "type": "multiple_choice",
      "prompt": "Field width for [hi:lo] is…",
      "choices": [
        "hi-lo",
        "hi-lo+1",
        "hi+lo",
        "2^(hi-lo)"
      ],
      "answer": 1,
      "explain": "Inclusive: w = hi − lo + 1.",
      "difficulty": "easy"
    },
    {
      "id": "bitfields_easy_02",
      "type": "multiple_choice",
      "prompt": "After masking a field, align it by…",
      "choices": [
        "<< lo",
        ">> lo",
        "& lo",
        "| lo"
      ],
      "answer": 1,
      "explain": "Mask, then >> lo.",
      "difficulty": "easy"
    },
    {
      "id": "bitfields_easy_03",
      "type": "multiple_choice",
      "prompt": "Neighbor bits stay put if you AND with…",
      "choices": [
        "mask",
        "~mask",
        "lo",
        "hi"
      ],
      "answer": 1,
      "explain": "AND with ~mask, then OR new bits.",
      "difficulty": "easy"
    },
    {
      "id": "bitfields_easy_04",
      "type": "true_false",
      "prompt": "hi >= lo for a nonempty field.",
      "answer": true,
      "explain": "LSB numbering; MSB-as-0 is a different convention.",
      "difficulty": "easy"
    },
    {
      "id": "bitfields_medium_01",
