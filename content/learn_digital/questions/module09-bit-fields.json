      "answer": 1,
      "explain": "0xA52D → field 7:3 is 5.",
      "difficulty": "medium"
    },
    {
      "id": "bitfields_medium_03",
      "type": "multiple_choice",
      "prompt": "((1<<w)-1)<<lo builds…",
      "choices": [
        "lo alone",
        "((1 << (hi - lo + 1)) - 1) << lo",
        "hi ^ lo",
        "~0 >> hi"
      ],
      "answer": 1,
      "explain": "Width ones, shifted to lo.",
      "difficulty": "medium"
    },
    {
      "id": "bitfields_medium_04",
