    {
      "id": "encoding_easy_01",
      "type": "multiple_choice",
      "prompt": "Binary encoding of N states needs how many FFs?",
      "choices": [
        "ceil(log2 N)",
        "N",
        "N−1",
        "2N"
      ],
      "answer": 0,
      "explain": "Compact minimum-width code.",
      "difficulty": "easy"
    },
    {
      "id": "encoding_easy_02",
      "type": "multiple_choice",
      "prompt": "One-hot width is…",
      "choices": [
        "N flip-flops (one bit high)",
        "ceil(log2 N) flip-flops",
        "1 flip-flop total",
        "No flip-flops"
      ],
      "answer": 0,
      "explain": "One FF per state.",
      "difficulty": "easy"
    },
    {
      "id": "encoding_easy_03",
      "type": "multiple_choice",
      "prompt": "Ring-friendly Gray steps have Hamming…",
      "choices": [
        "Exactly one bit",
        "All bits",
        "No bits",
        "Two N flip-flops"
      ],
      "answer": 0,
      "explain": "Single-bit steps on rings/counters.",
      "difficulty": "easy"
    },
    {
      "id": "encoding_easy_04",
      "type": "true_false",
      "prompt": "Four states in binary need two flip-flops.",
      "answer": true,
