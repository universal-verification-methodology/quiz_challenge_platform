      ],
      "answer": 0,
      "explain": "Add safe recovery, not hope.",
      "difficulty": "medium"
    },
    {
      "id": "encoding_medium_04",
      "type": "true_false",
      "prompt": "Hamming distance counts how many bits differ between codes.",
