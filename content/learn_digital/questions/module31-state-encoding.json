        "Zero always",
        "Exactly N flops",
        "Gray by definition"
      ],
      "answer": 0,
      "explain": "Both bits flip; decode can glitch.",
      "difficulty": "medium"
    },
    {
      "id": "encoding_medium_02",
      "type": "multiple_choice",
      "prompt": "Advantage of one-hot checks?",
      "choices": [
        "A single wire (that state's bit)",
        "Always fewer FFs than binary",
        "Automatic CDC safety",
        "Removing next-state logic"
      ],
      "answer": 0,
      "explain": "One FF per state simplifies decode.",
      "difficulty": "medium"
    },
    {
      "id": "encoding_medium_03",
      "type": "multiple_choice",
      "prompt": "Illegal/unused encodings should have…",
