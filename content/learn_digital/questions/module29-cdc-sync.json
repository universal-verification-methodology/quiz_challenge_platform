  "items": [
    {
      "id": "cdc_easy_01",
      "type": "multiple_choice",
      "prompt": "CDC stands for…",
      "choices": [
        "Clock-domain crossing",
        "Clock duty cycle",
        "Combinational delay check",
        "Core debug console"
      ],
      "answer": 0,
      "explain": "Signal crosses unrelated clocks.",
      "difficulty": "easy"
    },
    {
      "id": "cdc_easy_02",
      "type": "multiple_choice",
      "prompt": "In a 2-FF synchronizer, use…",
      "choices": [
        "q2 (second dst flop)",
        "q1 only",
        "async_in directly",
        "The source clock"
      ],
      "answer": 0,
      "explain": "q2 samples after settle time.",
      "difficulty": "easy"
    },
    {
      "id": "cdc_easy_03",
      "type": "multiple_choice",
      "prompt": "Safe multi-bit crossing uses…",
      "choices": [
        "Gray code, handshake, or async FIFO",
