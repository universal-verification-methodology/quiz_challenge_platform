{
  "module": "module15-dont-care-lab",
  "title": "Don't-care minimization",
  "items": [
    {
      "id": "dontcare_easy_01",
      "type": "multiple_choice",
      "prompt": "Don't-care rows in a truth table are written as…",
      "choices": [
        "0",
        "1",
        "X",
        "Z"
      ],
      "answer": 2,
      "explain": "X marks combinations that may be treated as 0 or 1.",
      "difficulty": "easy"
    },
    {
      "id": "dontcare_easy_02",
      "type": "multiple_choice",
      "prompt": "Onset that must be covered is the set of…",
      "choices": [
        "OFF minterms",
        "ON minterms",
        "X minterms only",
        "maxterms"
      ],
      "answer": 1,
      "explain": "ON (F=1) rows must be covered; OFF rows must not.",
      "difficulty": "easy"
    },
    {
      "id": "dontcare_easy_03",
      "type": "multiple_choice",
      "prompt": "Optional X entries often…",
      "choices": [
        "Always increases term count",
        "Can shrink the cover",
        "Forces POS only",
        "Ignores ON rows"
      ],
      "answer": 1,
      "explain": "X can enlarge groups and drop literals.",
      "difficulty": "easy"
    },
    {
      "id": "dontcare_easy_04",
      "type": "true_false",
      "prompt": "OFF rows are forbidden inside any valid implicant.",
      "answer": true,
      "explain": "Never cover a specified 0.",
      "difficulty": "easy"
    },
    {
      "id": "dontcare_medium_01",
      "type": "multiple_choice",
      "prompt": "Don't-care minterms in a cover are…",
      "choices": [
        "mandatory to cover",
        "forbidden to use",
        "optional — use if they help",
        "always forced to 0"
      ],
      "answer": 2,
      "explain": "X may join groups when helpful.",
      "difficulty": "medium"
    },
    {
      "id": "dontcare_medium_02",
      "type": "multiple_choice",
      "prompt": "Listing onset and X sets looks like…",
      "choices": [
        "only ΠM",
        "Σm(…) + d(…)",
        "only Gray codes",
        "FFT of the table"
      ],
      "answer": 1,
      "explain": "Σm with d(…) lists minterms and don't-cares.",
      "difficulty": "medium"
    },
    {
      "id": "dontcare_medium_03",
      "type": "multiple_choice",
      "prompt": "Leaving every X as OFF tends to…",
      "choices": [
        "always gives a smaller cover",
        "can miss a smaller legal cover",
        "forces dynamic hazards",
        "removes all ON rows"
      ],
      "answer": 1,
      "explain": "Treating X as OFF by default can miss a smaller cover.",
      "difficulty": "medium"
    },
    {
      "id": "dontcare_medium_04",
      "type": "true_false",
      "prompt": "Valid covers may leave some X uncovered.",
      "answer": true,
      "explain": "X is optional; leaving X uncovered is fine.",
      "difficulty": "medium"
    },
    {
      "id": "dontcare_hard_01",
      "type": "multiple_choice",
      "prompt": "A legal implicant may contain…",
      "choices": [
        "ON and X, never OFF",
        "OFF only",
        "OFF and ON mixed freely",
        "only X, never ON"
      ],
      "answer": 0,
      "explain": "Cover ON; optionally X; never OFF.",
      "difficulty": "hard"
    },
    {
      "id": "dontcare_hard_02",
      "type": "multiple_choice",
      "prompt": "Multiple minimal covers can exist when…",
      "choices": [
        "must be bitwise identical expressions",
        "are both functionally acceptable for specified F",
        "imply the truth table was wrong",
        "require POS instead"
      ],
      "answer": 1,
      "explain": "Different X choices can give different but valid covers.",
      "difficulty": "hard"
    },
    {
      "id": "dontcare_hard_03",
      "type": "multiple_choice",
      "prompt": "Don't-care justification should come from…",
      "choices": [
        "a clear spec of what is unreachable or unused",
        "always forcing X=1",
        "deleting the rows from silicon",
        "Gray-code axes only"
      ],
      "answer": 0,
      "explain": "Spec must say what is truly don't-care.",
      "difficulty": "hard"
    },
    {
      "id": "dontcare_hard_04",
      "type": "true_false",
      "prompt": "Once minimized with X, the ON set may legally shrink.",
      "answer": false,
      "explain": "ON must stay covered; OFF must stay uncovered.",
      "difficulty": "hard"
    },
    {
      "type": "multiple_choice",
      "prompt": "A 2-variable K-map has how many cells?",
      "choices": [
        "2",
        "4",
        "4",
        "2"
