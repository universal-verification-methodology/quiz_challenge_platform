  "items": [
    {
      "id": "seqdet_easy_01",
      "type": "multiple_choice",
      "prompt": "A sequence detector FSM recognizes…",
      "choices": [
        "A specific bit pattern in a serial stream",
        "Only combinational AND gates",
        "DRAM refresh timing",
        "UART stop bits only"
      ],
      "answer": 0,
      "explain": "Pattern in serial input.",
      "difficulty": "easy"
    },
    {
      "id": "seqdet_easy_02",
      "type": "multiple_choice",
      "prompt": "Mealy detect asserts Z on…",
      "choices": [
        "The last bit completes the pattern",
        "Every input is 1",
        "State is S0 only",
        "Overlap is disabled"
      ],
      "answer": 0,
      "explain": "Z on final matching bit.",
      "difficulty": "easy"
    },
    {
      "id": "seqdet_easy_03",
      "type": "multiple_choice",
      "prompt": "Suffix reuse after a match is…",
      "choices": [
        "A suffix of a match can start the next",
        "Patterns never share bits",
        "Z is always 0",
        "Only Moore style works"
      ],
      "answer": 0,
      "explain": "Reuse matched suffix.",
      "difficulty": "easy"
    },
    {
      "id": "seqdet_easy_04",
      "type": "true_false",
      "prompt": "Moore detectors often add a dedicated detect state where Z stays high.",
