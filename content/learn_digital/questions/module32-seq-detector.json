      "prompt": "On mismatch, good detectors often…",
      "choices": [
        "Jump to the longest proper prefix that still fits",
        "Ignore the stream forever",
        "Force Z=1",
        "Switch clocks"
      ],
      "answer": 0,
      "explain": "Reuse partial progress; do not waste matches.",
      "difficulty": "medium"
    },
    {
      "id": "seqdet_medium_02",
      "type": "multiple_choice",
      "prompt": "Pulse-on-arc vs level-in-detect-state…",
