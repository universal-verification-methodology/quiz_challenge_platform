{
  "module": "module12-boolean-laws",
  "title": "Boolean laws",
  "items": [
    {
      "id": "bool_easy_01",
      "type": "multiple_choice",
      "prompt": "De Morgan: ~(A·B) equals…",
      "choices": [
        "A'·B'",
        "A'+B'",
        "A+B",
        "A·B"
      ],
      "answer": 1,
      "explain": "NOT over AND becomes OR of the complements.",
      "difficulty": "easy"
    },
    {
      "id": "bool_easy_02",
      "type": "multiple_choice",
      "prompt": "A absorbs the redundant A·B term, leaving…",
      "choices": [
        "B",
        "A·B",
        "A",
        "1"
      ],
      "answer": 2,
      "explain": "A absorbs the redundant A·B term.",
      "difficulty": "easy"
    },
    {
      "id": "bool_easy_03",
      "type": "multiple_choice",
      "prompt": "What is the product of a literal and its complement?",
      "choices": [
        "0",
        "1",
        "A",
        "A'"
      ],
      "answer": 0,
      "explain": "A and its complement cannot both be true.",
      "difficulty": "easy"
    },
    {
      "id": "bool_easy_04",
      "type": "true_false",
      "prompt": "~~A always simplifies to A'.",
      "answer": false,
      "explain": "Two NOTs cancel.",
      "difficulty": "easy"
    },
    {
      "id": "bool_medium_01",
      "type": "multiple_choice",
      "prompt": "De Morgan: ~(A+B) equals…",
      "choices": [
        "A'+B'",
        "A'·B'",
        "A·B",
        "A+B"
      ],
      "answer": 1,
      "explain": "NOT over OR becomes AND of complements.",
      "difficulty": "medium"
    },
    {
      "id": "bool_medium_02",
      "type": "multiple_choice",
      "prompt": "Common factor A from AB+AC gives…",
      "choices": [
        "A+(B·C)",
        "A·(B+C)",
        "B·(A+C)",
        "(A+B)·C"
      ],
      "answer": 1,
      "explain": "A·(B+C) by distributivity.",
      "difficulty": "medium"
    },
    {
      "id": "bool_medium_03",
      "type": "multiple_choice",
      "prompt": "Complement law for sum: A+~A is…",
      "choices": [
        "0",
        "1",
        "A",
        "A'"
      ],
      "answer": 1,
      "explain": "A or not-A covers every case → 1.",
      "difficulty": "medium"
    },
    {
      "id": "bool_medium_04",
      "type": "true_false",
      "prompt": "A·(A+B) simplifies to B, not A.",
      "answer": false,
      "explain": "Dual absorption: A(A+B)=A.",
      "difficulty": "medium"
    },
    {
      "id": "bool_hard_01",
      "type": "multiple_choice",
      "prompt": "Consensus: AB + A'C + BC — the BC term is…",
      "choices": [
        "always illegal",
        "a consensus (redundant but useful) term",
        "required for canonical SOP only",
        "the same as De Morgan"
      ],
      "answer": 1,
      "explain": "Consensus BC is redundant algebraically but covers transitions.",
      "difficulty": "hard"
    },
    {
      "id": "bool_hard_02",
      "type": "multiple_choice",
      "prompt": "Pick the invalid Boolean step.",
      "choices": [
        "~(A·B) → ~A + ~B",
        "~(A+B) → ~A · ~B",
        "~(A·B) → ~A · ~B",
        "A + A·B → A"
      ],
      "answer": 2,
      "explain": "De Morgan flips operator; ~ (A·B) is ~A+~B, not ~A·~B.",
      "difficulty": "hard"
    },
    {
      "id": "bool_hard_03",
      "type": "multiple_choice",
      "prompt": "What is A+A?",
      "choices": [
        "0",
        "1",
        "A",
        "2A"
      ],
      "answer": 2,
      "explain": "A+A = A (idempotent).",
      "difficulty": "hard"
    },
    {
      "id": "bool_hard_04",
      "type": "true_false",
      "prompt": "You may freely drop a NOT from only one literal inside ~(AB).",
      "answer": false,
      "explain": "Partial De Morgan / arithmetic habits cause illegal steps.",
      "difficulty": "hard"
    },
