{
  "module": "module48-handshake",
  "title": "Handshake (valid/ready)",
  "items": [
    {
      "id": "handshake_easy_01",
      "type": "multiple_choice",
      "prompt": "A beat transfers when…",
      "choices": [
        "valid and ready are both 1 in the same cycle",
        "only valid is 1",
        "only ready is 1",
        "the clock stops"
      ],
      "answer": 0,
      "explain": "fire = valid && ready.",
      "difficulty": "easy"
    },
    {
      "id": "handshake_easy_02",
      "type": "multiple_choice",
      "prompt": "Initial teaching beat shows…",
      "choices": [
        "valid=ready=1, data 0xA5 — one transfer",
        "no signals asserted",
        "ready only, no valid",
        "three back-to-back beats"
      ],
      "answer": 0,
      "explain": "Both assert preset.",
      "difficulty": "easy"
    },
    {
      "id": "handshake_easy_03",
      "type": "multiple_choice",
      "prompt": "When sink is not ready…",
      "choices": [
        "holds valid and data stable until ready rises",
        "drops valid immediately every cycle",
        "loses the beat forever",
        "drives high-Z on the bus"
      ],
      "answer": 0,
      "explain": "Backpressure stability rule.",
      "difficulty": "easy"
    },
    {
      "id": "handshake_easy_04",
      "type": "true_false",
      "prompt": "A transfer needs only ready without valid.",
      "answer": false,
      "explain": "Both must be high.",
      "difficulty": "easy"
    },
    {
      "id": "handshake_medium_01",
      "type": "multiple_choice",
      "prompt": "Bubble cycle means…",
      "choices": [
        "No beat — valid or ready (or both) deasserted",
        "Always a transfer",
        "Reset only",
        "Memory full always"
      ],
      "answer": 0,
      "explain": "Not every cycle transfers.",
      "difficulty": "medium"
    },
    {
      "id": "handshake_medium_02",
      "type": "multiple_choice",
      "prompt": "Combinational ready paths risk…",
      "choices": [
        "Depend on valid (with care) or be registered — know the rule set",
        "Ignore valid forever",
        "Stop the clock",
        "Replace data"
      ],
      "answer": 0,
      "explain": "Protocol variants constrain ready timing.",
      "difficulty": "medium"
    },
    {
      "id": "handshake_medium_03",
      "type": "multiple_choice",
      "prompt": "Why insert a skid stage?",
      "choices": [
        "Break ready combinational loops / absorb one beat",
        "Remove all data",
        "Force full always",
        "Disable valid"
      ],
      "answer": 0,
      "explain": "Common ready/valid plumbing.",
      "difficulty": "medium"
    },
    {
      "id": "handshake_medium_04",
      "type": "true_false",
      "prompt": "fire can be 1 when valid=0.",
      "answer": false,
      "explain": "fire requires both.",
      "difficulty": "medium"
    },
    {
      "id": "handshake_hard_01",
      "type": "multiple_choice",
      "prompt": "Registered-output source that must not drop a beat under backpressure…",
      "choices": [
        "Keep valid/data until fire",
        "Toggle data each cycle anyway",
        "Clear valid immediately always",
        "Ignore ready"
      ],
      "answer": 0,
      "explain": "Hold until accepted.",
      "difficulty": "hard"
    },
    {
      "id": "handshake_hard_02",
      "type": "multiple_choice",
      "prompt": "Sustained full rate requires…",
      "choices": [
        "valid and ready both stay high every cycle",
        "valid only half the time always",
        "ready always 0",
        "No clock"
      ],
      "answer": 0,
      "explain": "fire each cycle.",
      "difficulty": "hard"
    },
    {
      "id": "handshake_hard_03",
      "type": "multiple_choice",
      "prompt": "Deadlock can occur if…",
      "choices": [
        "No fires / deadlock or lost beats",
        "Faster addition",
        "Automatic Gray coding",
        "Bigger caches"
      ],
      "answer": 0,
      "explain": "Both sides must speak the same protocol.",
      "difficulty": "hard"
    },
    {
      "id": "handshake_hard_04",
      "type": "true_false",
