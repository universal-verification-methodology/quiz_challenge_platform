{
  "module": "module49-block-diagram",
  "title": "Block-diagram integrator",
  "items": [
    {
      "id": "blkdiag_easy_01",
      "type": "multiple_choice",
      "prompt": "A legal wire in this lab goes…",
      "choices": [
        "from an output to an input of the same type",
        "from any input to any input",
        "only between identical block titles",
        "without types ever"
      ],
      "answer": 0,
      "explain": "out → in, matching addr/data/ctrl/instr.",
      "difficulty": "easy"
    },
    {
      "id": "blkdiag_easy_02",
      "type": "multiple_choice",
      "prompt": "Initial diagram includes…",
      "choices": [
        "ALU + RegFile datapath (CPU control to ALU/RF)",
        "CPU ↔ Memory completely",
        "Only the system bus",
        "Nothing — blank canvas"
      ],
      "answer": 0,
      "explain": "Four CPU↔Memory links still missing.",
      "difficulty": "easy"
    },
    {
      "id": "blkdiag_easy_03",
      "type": "multiple_choice",
      "prompt": "Complete the map with…",
      "choices": [
        "addr, wdata, rdata, and instr",
        "only the clock",
        "Gray pointers",
        "valid and ready only"
      ],
      "answer": 0,
      "explain": "Fetch and load/store paths.",
      "difficulty": "easy"
    },
    {
      "id": "blkdiag_easy_04",
      "type": "true_false",
      "prompt": "Any port may connect to any other port freely.",
      "answer": false,
      "explain": "Typed out→in only.",
      "difficulty": "easy"
    },
    {
      "id": "blkdiag_medium_01",
      "type": "multiple_choice",
      "prompt": "instr path is typically…",
      "choices": [
        "Memory → CPU instruction/data-for-fetch",
        "Only ALU→RegFile",
        "Reset only",
        "Baud rate"
      ],
      "answer": 0,
      "explain": "Fetch path.",
      "difficulty": "medium"
    },
    {
      "id": "blkdiag_medium_02",
      "type": "multiple_choice",
      "prompt": "Store data flows…",
      "choices": [
        "wdata: CPU→Mem; rdata: Mem→CPU",
        "Both always CPU→Mem",
