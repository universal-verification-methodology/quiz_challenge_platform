        "Neither connects"
      ],
      "answer": 0,
      "explain": "Write vs read data directions.",
      "difficulty": "medium"
    },
    {
      "id": "blkdiag_medium_03",
      "type": "multiple_choice",
      "prompt": "Address port direction in the lab model…",
      "choices": [
        "CPU output → Memory input",
        "Memory → CPU always",
        "Floating",
        "Only Gray"
      ],
      "answer": 0,
      "explain": "CPU issues addresses.",
      "difficulty": "medium"
    },
    {
      "id": "blkdiag_medium_04",
      "type": "true_false",
      "prompt": "Leaving rdata unwired breaks loads.",
      "answer": true,
      "explain": "Diagrams teach structure; protocols still matter.",
      "difficulty": "medium"
    },
    {
      "id": "blkdiag_hard_01",
      "type": "multiple_choice",
      "prompt": "A dangling required input means…",
      "choices": [
        "The design is incomplete — that port needs a driver",
        "Automatic success",
