{
  "module": "module05-gray-code",
  "title": "Gray code",
  "items": [
    {
      "id": "gray_easy_01",
      "type": "multiple_choice",
      "prompt": "Binary → Gray is commonly computed as…",
      "choices": [
        "B & (B >> 1)",
        "B ^ (B >> 1)",
        "B + (B >> 1)",
        "B << 1"
      ],
      "answer": 1,
      "explain": "Gray = B XOR (B >> 1).",
      "difficulty": "easy"
    },
    {
      "id": "gray_easy_02",
      "type": "multiple_choice",
      "prompt": "The defining Gray property for neighbors is…",
      "choices": [
        "0",
        "1",
        "All bits",
        "Exactly 2"
      ],
      "answer": 1,
      "explain": "Exactly one bit flips between adjacent codes.",
      "difficulty": "easy"
    },
    {
      "id": "gray_easy_03",
      "type": "multiple_choice",
      "prompt": "Single-bit pointer changes help because…",
      "choices": [
        "Gray is faster to add",
        "Only one bit changes across a synchronizer",
        "Gray ignores clocks",
        "Gray needs no width"
      ],
      "answer": 1,
      "explain": "One-bit transitions reduce CDC ambiguity.",
      "difficulty": "easy"
    },
    {
      "id": "gray_easy_04",
      "type": "true_false",
      "prompt": "Gray codes are mainly for adjacency, not for ALU arithmetic.",
      "answer": true,
      "explain": "Do not treat Gray bits as binary integers for normal math.",
      "difficulty": "easy"
    },
    {
      "id": "gray_medium_01",
      "type": "multiple_choice",
      "prompt": "Binary 0b0000 converts to Gray…",
      "choices": [
        "0b0011",
        "0b0000",
        "0b0000",
        "0b1111"
      ],
      "answer": 1,
      "explain": "Gray = 0000 ^ (0000>>1) = 0000.",
      "difficulty": "medium"
    },
    {
      "id": "gray_medium_02",
      "type": "multiple_choice",
      "prompt": "Gray on K-map labels ensures…",
      "choices": [
        "Differ in all variables",
        "Differ by one bit (logic adjacency)",
        "Count in binary order only",
        "Ignore don’t-cares"
      ],
      "answer": 1,
      "explain": "Gray order makes edge-neighbors Hamming distance 1.",
      "difficulty": "medium"
    },
    {
      "id": "gray_medium_03",
      "type": "true_false",
      "prompt": "Rotary encoders often output Gray to avoid multi-bit glitches.",
      "answer": true,
      "explain": "Gray is invertible; encoders prefer single-bit changes.",
      "difficulty": "medium"
    },
    {
      "id": "gray_medium_04",
      "type": "multiple_choice",
      "prompt": "In Gray→binary, bit[MSB] equals…",
      "choices": [
        "Always 0",
        "Gray’s MSB (then XOR chain downward)",
        "Always 1",
        "The LSB of Gray only"
      ],
      "answer": 1,
      "explain": "Binary MSB = Gray MSB; lower bits accumulate XORs.",
      "difficulty": "medium"
    },
    {
      "id": "gray_medium_05",
      "type": "multiple_choice",
      "prompt": "Binary 0b0100 converts to Gray…",
      "choices": [
        "0b0101",
        "0b0110",
        "0b1000",
        "0b1111"
      ],
      "answer": 1,
      "explain": "Gray = 0100 ^ (0100>>1) = 0110.",
      "difficulty": "medium"
    },
    {
      "id": "gray_hard_01",
      "type": "multiple_choice",
      "prompt": "If a synchronizer samples mid-transition of a multi-bit binary counter…",
