{
  "module": "module16-logic-hazards",
  "title": "Logic hazards",
  "items": [
    {
      "id": "hazard_easy_01",
      "type": "multiple_choice",
      "prompt": "Output should stay 1 but briefly dips to 0 — this is a…",
      "choices": [
        "static-0 hazard",
        "static-1 hazard",
        "dynamic hazard only",
        "no hazard"
      ],
      "answer": 1,
      "explain": "A glitch low while F should remain 1 is static-1.",
      "difficulty": "easy"
    },
    {
      "id": "hazard_easy_02",
      "type": "multiple_choice",
      "prompt": "For AB + A'C, the consensus product is…",
      "choices": [
        "AC",
        "BC",
        "AB",
        "A'B'"
      ],
      "answer": 1,
      "explain": "BC covers the cube shared when A changes.",
      "difficulty": "easy"
    },
    {
      "id": "hazard_easy_03",
      "type": "multiple_choice",
      "prompt": "0→1→0→1 on one intended transition is a…",
      "choices": [
        "static-1",
        "static-0",
        "dynamic hazard",
        "consensus"
      ],
      "answer": 2,
      "explain": "Multiple edges on one input change = dynamic hazard.",
      "difficulty": "easy"
    },
    {
      "id": "hazard_easy_04",
      "type": "true_false",
      "prompt": "Hazards mean the truth table itself is incorrect.",
      "answer": false,
      "explain": "Logic can be correct while timing glitches.",
      "difficulty": "easy"
    },
    {
      "id": "hazard_medium_01",
      "type": "multiple_choice",
      "prompt": "Output should stay 0 but briefly spikes to 1 — this is a…",
      "choices": [
        "static-0 hazard",
        "static-1 hazard",
        "only metastability",
        "no hazard"
      ],
      "answer": 0,
      "explain": "Spike high while staying 0 is static-0.",
      "difficulty": "medium"
    },
    {
      "id": "hazard_medium_02",
      "type": "multiple_choice",
      "prompt": "With B=C=1, changing A from 1→0 can glitch because…",
      "choices": [
        "both terms go away briefly under delay skew",
        "the function becomes XOR",
        "Cin is missing",
        "Gray code fails"
      ],
      "answer": 0,
      "explain": "One term drops before the other picks up → static-1.",
      "difficulty": "medium"
    },
    {
      "id": "hazard_medium_03",
      "type": "multiple_choice",
      "prompt": "Matched delays often…",
      "choices": [
        "hide glitches that still occur with real skew",
        "prove silicon is glitch-free forever",
        "remove the need for covers",
        "convert static to dynamic only"
      ],
      "answer": 0,
      "explain": "Equal delays can hide the glitch in sim but not in silicon.",
      "difficulty": "medium"
    },
    {
      "id": "hazard_medium_04",
      "type": "true_false",
      "prompt": "Hazard-free covers still implement the same Boolean function.",
      "answer": true,
      "explain": "Consensus is redundant for F but covers the transition.",
      "difficulty": "medium"
    },
    {
      "id": "hazard_hard_01",
